# MongoDB
# Inside docker-compose, the backend talks to the mongo service by name on its internal port:
#   MONGODB_URI=mongodb://mongo:27017
# Running the backend directly on the host (outside Docker), use the mapped host port instead:
# Production (MongoDB Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
#   (requires dnspython, pinned in requirements.txt)
MONGODB_URI=mongodb://localhost:27018
MONGODB_DB_NAME=clarivue_ai

# Auth: real JWT login (Phase 9 Stage 2) via POST /api/auth/login, plus the
# original demo-header mechanism (X-Organisation-Id/X-User-Id) kept for
# local dev/demo convenience -- a request with a valid Bearer token always
# wins over those headers. Set both to false/true respectively ONLY in
# production:
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
# Production: true -- rejects any request with no valid JWT (no demo-header fallback).
REQUIRE_JWT_AUTH=false
# Production: false -- disables the unauthenticated /api/demo/* org/user enumeration endpoints.
ENABLE_DEMO_ENDPOINTS=true

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Phase 5: AI provider key — never commit real values.
# Gemini (analysis/claim-extraction AND embeddings, one key for both):
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# File storage — local path in dev; point at a mounted persistent disk in
# production (see render.yaml) so uploads survive redeploys.
STORAGE_ROOT=storage
MAX_GUIDELINE_UPLOAD_MB=20
MAX_ASSET_UPLOAD_MB=5
